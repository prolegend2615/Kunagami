DISCORD_TOKEN=put_your_bot_token_here
# Optional: set this to a development server ID for near-instant slash command updates.
DISCORD_GUILD_ID=

# Optional: where the SQLite database lives. Defaults to hallowscape.sqlite3 beside this project.
# An old single-file database at this path is upgraded in place on first boot; nothing is deleted.
HALLOWSCAPE_DB=

# Optional: jumpscare GIFs, comma-separated. Either a bare URL (used for any scare)
# or `tag=url` to bind a GIF to a specific story event. Tags are defined in
# hallowscape/story.py in SCARES: window_flash, ground_knock, wrist, behind_you,
# bell, booth, chalk, screen. Only https URLs are accepted. Every file is fetched,
# checked for flashing frames, and sent spoiler-tagged; a GIF that fails the check
# is replaced by the written line instead. Players can turn GIFs off in Settings.
JUMPSCARE_GIFS=

# Optional: the town clock. The bot wakes on this interval and, for every player
# who has been away at least HALLOWSCAPE_IDLE_HOURS, queues one thing the town did
# without them (no player gets more than one per HALLOWSCAPE_EVENT_HOURS).
# Set HALLOWSCAPE_CLOCK=0 to keep the story alive but leave the world still.
HALLOWSCAPE_CLOCK=1
HALLOWSCAPE_CLOCK_MINUTES=30
HALLOWSCAPE_IDLE_HOURS=6
HALLOWSCAPE_EVENT_HOURS=12

# Optional: GIF screening limits. Flashing files are refused unless you allow them,
# and a refused file is replaced by prose. Raise ALLOW_FLASHING only if you have
# looked at the frames yourself.
HALLOWSCAPE_MAX_GIF_KB=6144
HALLOWSCAPE_ALLOW_FLASHING=0
